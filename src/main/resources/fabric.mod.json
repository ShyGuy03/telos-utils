    "issues": "https://github.com/ShyGuy03/telos-utils/issues"
  },
  "license": "MIT",
  "icon": "assets/telosutils/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.telosutils.TelosUtilsClient"]
  },
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~26.1",
    "java": ">=25",
    "fabric-api": "*"
  }
}
